# Variables read by docker-compose.yml. Every one of them has a development
# default, so this file is optional: copy it to .env only to override values.
#
#   cp .env.example .env

# Symfony application secret (any long random string).
APP_SECRET=dev-only-secret-not-for-production

# HMAC key for the X-Task-Signature header of webhook notifications (any long
# random string; the receiver needs the same value to verify them).
CALLBACK_SIGNING_SECRET=dev-only-callback-signing-secret-replace-me

# MySQL (the application never uses the root account).
DB_NAME=app
DB_USER=app
DB_PASSWORD=app

# RabbitMQ credentials (broker and management UI).
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app

# URL clients use to reach the API through nginx; video URLs are built from it.
PUBLIC_BASE_URL=http://localhost:8080

# How long (seconds) a task may stay "processing" before another worker may take
# it over. Only reached when a worker is killed mid-task.
TASK_LEASE_SECONDS=3600

# How long (seconds) an Idempotency-Key sent with POST /api/tasks is remembered.
IDEMPOTENCY_TTL_SECONDS=86400

# API keys, as "name:secret" pairs separated by commas; secrets of at least 16
# characters. Empty - the default - leaves the API open.
API_TOKENS=

# HMAC key for the signed video URLs (any long random string), and how long one
# stays valid. Empty serves the videos unsigned; set it whenever API_TOKENS is
# set, or the videos of an authenticated API stay readable by anyone with the
# link.
VIDEO_URL_SECRET=
VIDEO_URL_TTL_SECONDS=3600

# How many tasks one caller may create per minute. 0 - the default - turns the
# limit off entirely.
RATE_LIMIT_TASK_CREATION=0

# Render defaults for a task that does not choose its own: seconds per clip
# (1-15), frames per second (24, 25 or 30), frame size (1280x720 or 1920x1080)
# and seconds of crossfade between clips (0-2; 0 is a hard cut).
RENDER_DEFAULT_DURATION=3
RENDER_DEFAULT_FPS=30
RENDER_DEFAULT_RESOLUTION=1280x720
RENDER_DEFAULT_CROSSFADE=0

# Host ports.
HTTP_PORT=8080
MYSQL_PORT=3307
RABBITMQ_MANAGEMENT_PORT=15672
