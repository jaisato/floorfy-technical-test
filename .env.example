# Docker Compose environment variables
# Copy this file to .env and fill in the values

UID=1000
GID=1000

# MySQL / Database
DB_NAME=app
DB_USER=app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Symfony
APP_SECRET=

# GCP
GCP_PROJECT_ID=
GCP_VERTEX_LOCATION=us-central1
GCP_GCS_BUCKET=
