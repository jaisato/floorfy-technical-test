# Committed defaults, loaded in every environment. Nothing here is a secret.
#
# Precedence (lowest to highest): .env < .env.local < .env.$APP_ENV <
# .env.$APP_ENV.local, and real environment variables - what docker-compose and
# CI set - always win over all of them. Machine-specific or secret values belong
# in .env.local, which is git-ignored.
#
# This file has to exist: Dotenv::bootEnv() throws without it, which takes down
# bin/console, the test bootstrap and every HTTP request.

###> symfony/framework-bundle ###
APP_ENV=dev
# Placeholder. Set a real value in .env.local, or in the deployment environment.
APP_SECRET=dev-only-not-a-secret-replace-me
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base URI for URLs generated outside an HTTP request (console, worker).
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# The "mysql" service of docker-compose.yml, reached from the host, where it
# publishes 3307. Inside the compose network the value is overridden to
# mysql:3306. The application never connects as root.
DATABASE_URL="mysql://app:app@127.0.0.1:3307/app?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# RabbitMQ from docker-compose.yml. Messages whose retries are exhausted land in
# the "failed" queue instead of being dropped.
MESSENGER_TRANSPORT_DSN=amqp://app:app@127.0.0.1:5672/%2f/messages
MESSENGER_FAILURE_TRANSPORT_DSN=amqp://app:app@127.0.0.1:5672/%2f/failed
# Webhook notifications travel on their own queue, with their own retries.
MESSENGER_CALLBACKS_TRANSPORT_DSN=amqp://app:app@127.0.0.1:5672/%2f/callbacks
###< symfony/messenger ###

# HMAC-SHA256 key for the X-Task-Signature header of webhook notifications.
# Placeholder: set a long random value per deployment (.env.local or the
# environment); notifications are not sent while it is empty.
CALLBACK_SIGNING_SECRET=dev-only-callback-signing-secret-replace-me

# Public base URL of the API. The video URLs handed back by it are built from
# this, so it has to be the address clients actually use.
APP_URL=http://localhost:8080

# How long (seconds) a task may stay "processing" before another worker may take
# it over. Only reached when a worker dies mid-task; it must comfortably exceed
# the time one task takes.
TASK_LEASE_SECONDS=3600

# How long (seconds) an Idempotency-Key sent with POST /api/tasks is remembered.
IDEMPOTENCY_TTL_SECONDS=86400

# Wall-clock budget for a single ffmpeg run, in seconds, and the thread cap it
# is given (0 lets ffmpeg decide).
FFMPEG_ANIMATE_TIMEOUT=600
FFMPEG_COMPOSE_TIMEOUT=3600
FFMPEG_THREADS=0
