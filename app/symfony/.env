# Committed defaults, loaded in every environment. Nothing here is a secret.
#
# Precedence (lowest to highest): .env < .env.local < .env.$APP_ENV <
# .env.$APP_ENV.local, and real environment variables - what docker-compose and
# CI set - always win over all of them. Machine-specific or secret values belong
# in .env.local, which is git-ignored.
#
# This file has to exist: Dotenv::bootEnv() throws without it, which takes down
# bin/console, the test bootstrap and every HTTP request.

###> symfony/framework-bundle ###
APP_ENV=dev
# Placeholder. Set a real value in .env.local, or in the deployment environment.
APP_SECRET=dev-only-not-a-secret-replace-me
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base URI for URLs generated outside an HTTP request (console, worker).
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# The "mysql" service of docker-compose.yml, reached from the host, where it
# publishes 3307. Inside the compose network the value is overridden to
# mysql:3306. The application never connects as root.
DATABASE_URL="mysql://app:app_dev_password@127.0.0.1:3307/app?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# RabbitMQ from docker-compose.yml. Messages whose retries are exhausted land in
# the "failed" queue instead of being dropped.
MESSENGER_TRANSPORT_DSN=amqp://app:app_dev_password@127.0.0.1:5672/%2f/messages
MESSENGER_FAILURE_TRANSPORT_DSN=amqp://app:app_dev_password@127.0.0.1:5672/%2f/failed
# Webhook notifications travel on their own queue, with their own retries.
MESSENGER_CALLBACKS_TRANSPORT_DSN=amqp://app:app_dev_password@127.0.0.1:5672/%2f/callbacks
###< symfony/messenger ###

# HMAC-SHA256 key for the X-Task-Signature header of webhook notifications.
# Placeholder: set a long random value per deployment (.env.local or the
# environment); notifications are not sent while it is empty.
CALLBACK_SIGNING_SECRET=dev-only-callback-signing-secret-replace-me

# Public base URL of the API. The video URLs handed back by it are built from
# this, so it has to be the address clients actually use.
APP_URL=http://localhost:8080

# How long (seconds) a task may stay "processing" before another worker may take
# it over. Only reached when a worker dies mid-task: a healthy attempt renews
# the claim between parts.
#
# It is a floor, not the whole answer. Renewals happen between parts and never
# during one, so the longest a live attempt goes without touching the row is one
# ffmpeg run, and the application uses whichever is longer - this, or
# max(FFMPEG_ANIMATE_TIMEOUT, FFMPEG_COMPOSE_TIMEOUT) plus a few minutes. Raise
# the compose timeout and the lease follows it; nothing here can be set to a
# value that lets a working render be declared abandoned.
TASK_LEASE_SECONDS=3600

# How long (seconds) an Idempotency-Key sent with POST /api/tasks is remembered.
IDEMPOTENCY_TTL_SECONDS=86400

# API keys, as "name:secret" pairs separated by commas; secrets of at least 16
# characters. Empty - the default - leaves the API open. Set it and every
# request outside /health, /videos and /api/doc.json needs
# "Authorization: Bearer <secret>" or "X-API-Key: <secret>".
API_TOKENS=

# HMAC key for the signed video URLs. Empty - the default - serves the videos
# unsigned, as before; set it (together with API_TOKENS) and every video URL
# the API hands out carries "expires" and "sig", and nothing else is served.
VIDEO_URL_SECRET=

# How long (seconds) a signed video URL stays valid.
VIDEO_URL_TTL_SECONDS=3600

# When set, the video controller answers with X-Accel-Redirect under this
# prefix and nginx streams the file, so PHP never carries the bytes. Empty
# outside Docker, where there is no nginx to hand them to.
VIDEOS_X_ACCEL_PREFIX=

# How many tasks one caller may create per minute. 0 - the default - turns the
# limit off entirely (the limiter is not even consulted).
RATE_LIMIT_TASK_CREATION=0

# Behind a reverse proxy or load balancer (TLS termination), the client's address
# and scheme arrive in X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Port, and
# they are believed only from the addresses listed here (comma separated; IPs,
# CIDR ranges, "private_ranges" or "REMOTE_ADDR" for whatever connects directly).
# Empty - the default - ignores the headers: every caller is then the proxy's
# address to the creation limit above, and the Link headers of the listings
# carry the proxy's scheme. The compose stack needs none: nginx talks FastCGI
# to php-fpm and passes the real client address as REMOTE_ADDR.
# SYMFONY_TRUSTED_HEADERS adds x-forwarded-host / x-forwarded-prefix when the
# proxy rewrites the host or mounts the API under a path.
SYMFONY_TRUSTED_PROXIES=

# Default render options for a task that does not choose its own: seconds per
# clip (1-15), frames per second (24, 25 or 30), frame size (1280x720 or
# 1920x1080) and seconds of crossfade between clips (0-2; 0 is a hard cut).
RENDER_DEFAULT_DURATION=3
RENDER_DEFAULT_FPS=30
RENDER_DEFAULT_RESOLUTION=1280x720
RENDER_DEFAULT_CROSSFADE=0

# Wall-clock budget for a single ffmpeg run, in seconds, and the thread cap it
# is given (0 lets ffmpeg decide).
FFMPEG_ANIMATE_TIMEOUT=600
FFMPEG_COMPOSE_TIMEOUT=3600
FFMPEG_THREADS=0
