# Test environment. Values here are committed and non-secret; CI overrides
# DATABASE_URL with the MySQL service so the "mysql" group can run.
KERNEL_CLASS='App\Kernel'
APP_SECRET='test-secret-not-used-outside-the-suite'

# SQLite keeps the functional tests runnable on a clean clone with no services.
# tests/bootstrap.php creates the schema from the mapping; the migrations
# themselves are MySQL DDL and are exercised in CI.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# Overridden to in-memory:// by config/packages/test/messenger.yaml; kept here
# so the DSNs resolve while the container is being built.
MESSENGER_TRANSPORT_DSN=in-memory://
MESSENGER_CALLBACKS_TRANSPORT_DSN=in-memory://
MESSENGER_FAILURE_TRANSPORT_DSN=in-memory://

CALLBACK_SIGNING_SECRET=test-only-callback-signing-secret

APP_URL=http://localhost
