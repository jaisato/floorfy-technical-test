# deps
/vendor/
node_modules/

# Local overrides only. app/symfony/.env is committed on purpose: it holds the
# non-secret defaults every environment starts from (the Symfony convention).
# Real secrets and machine-specific values go in a .env.local, never here.
/.env
.env.local
.env.*.local

# cache/logs
**/var/
**/var/cache/
**/var/log/

# generated media
app/symfony/public/videos/

# tests / tooling
.phpunit.result.cache
**/.phpunit.cache/
**/.php-cs-fixer.cache
*.db
*.sqlite

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db
